# Choose exactly one backend for each environment.
LAMILIA_BACKEND=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase/production example:
# LAMILIA_BACKEND=supabase
# NEXT_PUBLIC_APP_URL=https://www.example.com
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_SECRET_KEY=sb_secret_replace_me_server_only
# SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only_legacy
# AUTH_RESUME_SECRET=replace_me_with_a_long_random_server_only_secret
# DEMO_SESSION_SECRET=replace_me_for_local_signed_urls

# Optional image-storage cutover. Keep Supabase as the default until the
# private/public R2 buckets, custom domain, CORS, and credentials are verified.
# MEDIA_STORAGE_PROVIDER=supabase
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_BASE_URL=https://media.example.com
